<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Afrowave.Toolbox.ExchangeHouse.Markdown</PackageId>
    <AssemblyName>Afrowave.Toolbox.ExchangeHouse.Markdown</AssemblyName>
    <RootNamespace>Afrowave.Toolbox.ExchangeHouse.Markdown</RootNamespace>
    <Description>UI-neutral Markdown document inspection and lossless source-preserving parsing foundation for Afrowave.Toolbox.</Description>
    <PackageTags>afrowave;toolbox;exchangehouse;markdown;parser;writer;documentation</PackageTags>
    <PackageProjectUrl>https://github.com/afrowaveltd/Toolbox/tree/master/ExchangeHouse/Markdown</PackageProjectUrl>
    <Version>0.1.0-preview.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
