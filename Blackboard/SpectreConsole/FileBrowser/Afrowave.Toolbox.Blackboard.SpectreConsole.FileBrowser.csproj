<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Afrowave.Toolbox.Blackboard.SpectreConsole.FileBrowser</PackageId>
    <AssemblyName>Afrowave.Toolbox.Blackboard.SpectreConsole.FileBrowser</AssemblyName>
    <RootNamespace>Afrowave.Toolbox.Blackboard.SpectreConsole.FileBrowser</RootNamespace>
    <Description>Interactive, read-only Spectre.Console file and directory picker for .NET 10 with wildcard/regex filters, lazy folder tree and bounded recursive search.</Description>
    <PackageTags>afrowave;toolbox;blackboard;filebrowser;tui;spectre-console;file-picker;directory-picker;filter;search</PackageTags>
    <PackageProjectUrl>https://github.com/afrowaveltd/Toolbox/tree/master/Blackboard/SpectreConsole/FileBrowser</PackageProjectUrl>
    <PackageReleaseNotes>First preview of the interactive local file/directory picker with customizable filename filters, lazy tree and bounded recursive search. Public NuGet publication and real-terminal compatibility testing remain pending.</PackageReleaseNotes>
    <Version>0.1.0-preview.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
