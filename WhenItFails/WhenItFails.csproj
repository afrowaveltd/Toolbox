<?xml version="1.0" encoding="UTF-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Afrowave.Toolbox.WhenItFails</PackageId>
        <AssemblyName>Afrowave.Toolbox.WhenItFails</AssemblyName>
        <RootNamespace>Afrowave.Toolbox.WhenItFails</RootNamespace>
        <Description>Structured error catalogs, runtime resolution, recovery, profiles, mapping, and diagnostics for Afrowave Toolbox.</Description>
        <PackageTags>afrowave;toolbox;whenitfails;errors;errorhandling;dotnet;foundation</PackageTags>
        <Version>0.1.0</Version>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Essentials\Essentials.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Folder Include="Codes\" />
        <Folder Include="Customization\" />
        <Folder Include="Docs\Philosophy\" />
        <Folder Include="Mapping\" />
        <Folder Include="Exceptions\" />
        <Folder Include="DependencyInjection\" />
        <Folder Include="Exporting\" />
        <Folder Include="Jsons\" />
        <Folder Include="Serialization\" />
        <Folder Include="Storage\" />
        <Folder Include="Profiles\" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="../Jsons/WhenItFails/errors.en.json">
            <Link>Bootstrap/Templates/errors.en.json</Link>
            <LogicalName>Afrowave.Toolbox.WhenItFails.Bootstrap.Templates.errors.en.json</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="../Jsons/WhenItFails/categories.en.json">
            <Link>Bootstrap/Templates/categories.en.json</Link>
            <LogicalName>Afrowave.Toolbox.WhenItFails.Bootstrap.Templates.categories.en.json</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="../Jsons/WhenItFails/code-groups.en.json">
            <Link>Bootstrap/Templates/code-groups.en.json</Link>
            <LogicalName>Afrowave.Toolbox.WhenItFails.Bootstrap.Templates.code-groups.en.json</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="../Jsons/WhenItFails/owners.en.json">
            <Link>Bootstrap/Templates/owners.en.json</Link>
            <LogicalName>Afrowave.Toolbox.WhenItFails.Bootstrap.Templates.owners.en.json</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="../Jsons/WhenItFails/profiles.json">
            <Link>Bootstrap/Templates/profiles.json</Link>
            <LogicalName>Afrowave.Toolbox.WhenItFails.Bootstrap.Templates.profiles.json</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions"
                          Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder"
                          Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"
                          Version="10.0.9" />
    </ItemGroup>
</Project>