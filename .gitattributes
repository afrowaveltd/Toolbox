###############################################################################
# Repository-wide line-ending policy
#
# GitHub is the source of truth. Keep all cross-platform text files in LF form
# in both the index and working tree so Windows/Linux checkouts do not create
# line-ending-only diffs. Native cmd.exe scripts are the only CRLF exception.
###############################################################################
* text=auto eol=lf

# Native Windows command scripts.
*.bat text eol=crlf
*.cmd text eol=crlf

###############################################################################
# Binary files
###############################################################################
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.nupkg binary
*.snupkg binary
*.dll binary
*.pdb binary

###############################################################################
# Optional diff / merge hints
###############################################################################
#*.cs       diff=csharp
#*.sln      merge=binary
#*.csproj   merge=binary
#*.vbproj   merge=binary
